{
  "version": 2,
  "builds": [
    {
      "src": "build/public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.php",
      "use": "@vercel/php",
      "config": {
        "includeFiles": [
          "public/**",
          "resources/**",
          "routes/**",
          "vendor/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}